# ==============================================================================
# VAANI — ENVIRONMENT & INFRASTRUCTURE CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your hosting platform's secret manager (Cloud Run / Render / GitHub Actions
# / Supabase Edge Functions / Cloudflare Workers).
#
# SECURITY NOTICE:
# - NEVER commit `.env` or real secret values to version control.
# - Variables prefixed with `SUPABASE_SERVICE_ROLE_KEY`, `SUPABASE_SECRET_KEYS`,
#   or `VAANI_NOTIFICATIONS_SYNC_SECRET` are SERVER-ONLY secrets and must never
#   be exposed in frontend JavaScript or HTML.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS / EXPRESS APPLICATION SERVER
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production
NODE_ENV=development

# HTTP listen port (defaults to 3000)
PORT=3000

# Optional comma-separated list of additional allowed CORS origins for the API
# Default allowed origins include:
# - https://harshiiiit-bh.github.io
# - http://localhost:3000, http://127.0.0.1:3000
# - http://localhost:4173, http://127.0.0.1:4173
# - https://*-vaanii.vercel.app, https://*.run.app
VAANI_ALLOWED_ORIGINS=https://harshiiiit-bh.github.io

# Optional request timeout in milliseconds (defaults to 15000)
VAANI_REQUEST_TIMEOUT_MS=15000

# Optional custom path for the persistent runtime JSON store
# Defaults to ./data/runtime-store.json
VAANI_RUNTIME_STORE_PATH=

# Optional custom directory for automated state & database backups
# Defaults to ./backups
VAANI_BACKUP_DIR=

# ------------------------------------------------------------------------------
# 2. FRONTEND / STATIC HOSTING (GITHUB PAGES <-> EXPRESS API BRIDGE)
# ------------------------------------------------------------------------------
# When hosting the static frontend on GitHub Pages (https://harshiiiit-bh.github.io/vaanii/)
# and running the Node.js/Express backend on a separate origin, set VAANI_API_BASE
# (or window.VAANI_API_BASE) to the HTTPS base URL of the Express server.
# Leave empty when serving frontend and backend from the same Express origin.
VAANI_API_BASE=

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & EDGE FUNCTIONS (ARENA & CLOUD SYNC)
# ------------------------------------------------------------------------------
# Public project URL (safe for client & server)
SUPABASE_URL=https://pccavdwwhykwyeitxixc.supabase.co

# Public publishable / anon key (RLS-enforced; safe for public read/insert)
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# SERVER-ONLY: Supabase Service Role key (used ONLY inside Edge Functions / backend)
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY: Optional JSON secret map for Supabase Edge Functions
SUPABASE_SECRET_KEYS=

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE D1 & SCHEDULED DEFENCE NOTIFICATIONS PIPELINE
# ------------------------------------------------------------------------------
# Public Cloudflare Worker endpoint for Defence & Government Exam notifications
VAANI_NOTIFICATIONS_API=https://vaani-notifications-api.workers.dev

# SERVER-ONLY: Shared secret used by GitHub Actions (.github/workflows/defence-notifications.yml)
# to authenticate POST /api/notifications/sync writes to the Cloudflare Worker
VAANI_NOTIFICATIONS_SYNC_SECRET=
